# Copy this file to .env.local (or .env) and fill in the values.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Address that receives contact form enquiries
CONTACT_TO_EMAIL=info@sinneogroup.co.za

# Sender address. Must be on a domain verified in Resend,
# e.g. "Sinneo Website <website@sinneogroup.co.za>"
CONTACT_FROM_EMAIL=
